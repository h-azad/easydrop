# EasyDrop environment example
#
# Copy this file to .env for Docker Compose or to the relevant platform
# environment variable settings for deployment.

# Public URL of the signaling server from the browser's perspective.
# For local desktop testing, localhost is fine.
# For LAN/mobile testing, use your machine IP, for example:
# NEXT_PUBLIC_SIGNALING_URL=http://192.168.1.10:4000
NEXT_PUBLIC_SIGNALING_URL=http://localhost:4000

# Signaling server port.
PORT=4000

# Origin allowed to connect to the signaling server.
# Must match the web app origin exactly in production.
CLIENT_ORIGIN=http://localhost:3000

# Redis connection string for signaling session storage.
# If omitted, the signaling server uses in-memory storage.
REDIS_URL=redis://localhost:6379

# Docker Compose defaults.
# These are read by docker-compose.yml when present.
COMPOSE_PROJECT_NAME=easydrop
